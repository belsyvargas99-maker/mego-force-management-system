# Plantilla de variables de entorno. Copia este archivo como .env (no se sube a git).
# Ninguna de estas variables es secreta.

# ---------------------------------------------------------------
# Frontend (se fijan al CONSTRUIR la imagen; en Docker van como build-args)
# ---------------------------------------------------------------
# Subdominio del portal publico (clientes)
VITE_PUBLIC_HOST=mego-registro.systemagencygarciavargas.tech
# Subdominio del panel administrativo
VITE_ADMIN_HOST=mego-admin.systemagencygarciavargas.tech
# Forzar un modo (public | admin | all). Normalmente se deja comentada:
# el modo se decide por el subdominio.
# VITE_APP_MODE=all

# ---------------------------------------------------------------
# Servidor (se leen al ARRANCAR el contenedor)
# ---------------------------------------------------------------
PORT=3000
# NODE_ENV no hace falta aqui: `npm run dev` arranca en desarrollo (con Vite) y
# `npm start` / Docker ejecutan el build compilado, que siempre corre en produccion.
# NODE_ENV=production
PUBLIC_HOST=mego-registro.systemagencygarciavargas.tech
ADMIN_HOST=mego-admin.systemagencygarciavargas.tech
# Modo de respaldo (public | admin | all). Si se deja vacio: localhost = todo,
# cualquier otro host desconocido = public. En Hostinger va fijo en public
# (ojo: con APP_MODE=public tambien localhost queda en modo publico).
# APP_MODE=public
# Correos con permiso de administrador, separados por comas.
# Ademas cuentan los documentos authorizedAdmins/{email} de Firestore.
ADMIN_EMAILS=belsyvargas99@gmail.com
# true = la CSP solo informa en consola y no bloquea (plan B si falla el login)
CSP_REPORT_ONLY=false
# Peticiones por minuto y por IP a las rutas del panel (/api/uploads, /api/import,
# /api/contracts, /api/sheets). Por defecto 120.
# ADMIN_RATE_LIMIT_MAX=120

# ---------------------------------------------------------------
# Firebase (opcionales: por defecto salen de firebase-applet-config.json)
# ---------------------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=
